+   "Manual tensioner"
+  ],
+  [
+   "Charging",
+   "Check R/R"
+  ]
+ ],
+ "remove": [
+  "G-005",
+  "H-004"
+ ],
+ "patch": {},
+ "add": [
+  {
+   "id": "X-CBD-01",
+   "phase": "B",
+   "after": "B-004",
+   "title": "Listen for a knock low in the engine",
+   "instructions": "Start it cold and listen near the starter motor area. A knock there can be a worn primary chain tensioner. Drop the oil pan and look for pieces of the tensioner wheels.",
+   "reason": "Worn primary chain tensioners are a known DOHC CB750 problem, and the parts are hard to find new.",
+   "src": "cb750.com forum",
+   "safety": "Normal",
+   "skill": "Intermediate",
+   "estHours": 0.5,
+   "tools": ""
+  }
+ ],
+ "lessons": {
+  "G": [
+   "Rebuild one carb at a time and keep each one's parts apart."
+  ]
+ },
+ "recalls": [],
+ "recallNote": "Any recalls on bikes this old were closed long ago.",
+ "known": [
+  {
+   "title": "Primary chain tensioner",
+   "what": "Owners report knocking near the starter from a worn primary chain tensioner. Parts are no longer sold by Honda.",
+   "src": "https://www.cb750.com/goto/post?id=13801"
+  }
+ ],
+ "forums": [
+  {
+   "name": "CB750.com",
+   "url": "https://www.cb750.com/",
+   "what": "Owner forum for SOHC and DOHC CB750s."
+  }
+ ],
+ "heroName": "CB750"
+}
