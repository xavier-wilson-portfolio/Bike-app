+ "years": [
+  1979,
+  1983
+ ],
+ "match": [
+  "cb750 dohc",
+  "cb750k",
+  "cb750f",
+  "cb750c",
+  "cb750 custom",
+  "cb750 super sport",
+  "cb750k ltd",
+  "cb750 1980",
+  "cb750 1981",
+  "cb750 1982"
+ ],
+ "style": "standard",
+ "drive": "chain",
+ "engine": "749 cc air-cooled DOHC 16-valve inline four, four carbs",
+ "intro": "The twin-cam CB750 that replaced the SOHC. The primary chain tensioner and the cam chain tensioner are the parts to check.",
+ "focus": [
+  [
+   "749 cc DOHC four",
+   "Air-cooled, 16 valves"
+  ],
+  [
+   "Four carbs",
+   "Rebuild as a set"
+  ],
+  [
+   "Primary tensioner",
+   "Wheels wear"
