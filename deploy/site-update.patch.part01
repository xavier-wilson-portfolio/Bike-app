+   "id": "18V033",
+   "years": "2015-2018 (some)",
+   "what": "Front brake master cylinder piston may crack.",
+   "fix": "Free dealer repair.",
+   "src": "https://vehiclesafetyrecalls.com/recall/18V033000"
