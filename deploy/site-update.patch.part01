diff --git a/data/tunes/indian-chief-2014.json b/data/tunes/indian-chief-2014.json
new file mode 100644
index 0000000..2753a64
--- /dev/null
+++ b/data/tunes/indian-chief-2014.json
@@ -0,0 +1,105 @@
+{
+ "id": "indian-chief-2014",
+ "make": "Indian",
+ "model": "Chief (Thunder Stroke 111)",
+ "name": "Indian Chief (2014-on)",
+ "years": [
+  2014,
+  2026
+ ],
+ "match": [
+  "indian chief",
+  "chief classic",
+  "chief vintage",
+  "chief dark horse",
+  "chieftain",
+  "springfield",
+  "roadmaster",
+  "thunder stroke"
+ ],
+ "style": "cruiser",
+ "drive": "belt",
+ "engine": "1811 cc air/oil-cooled Thunder Stroke 111 V-twin (116 from 2020), fuel injected, belt drive",
+ "intro": "The modern Chief family. The Thunder Stroke 111 bikes had several recalls, including a fuel rail recall on 2014-2017 bikes.",
+ "focus": [
+  [
+   "Thunder Stroke V-twin",
+   "Air/oil-cooled"
+  ],
+  [
+   "Fuel injected",
+   "No carbs"
+  ],
+  [
+   "Fuel rail recall",
+   "2014-2017"
+  ],
+  [
+   "Belt drive",
+   "Check for cracks"
+  ],
+  [
+   "Lighting recalls",
+   "2014"
+  ]
+ ],
+ "remove": [
+  "G-004",
+  "H-004"
+ ],
+ "patch": {
+  "A-002": {
+   "title": "Check for open recalls first",
+   "instructions": "Run your VIN at nhtsa.gov/recalls. 2014-2016 Thunder Stroke bikes are in recall 16V446 (misfire can overheat the exhaust). 2014-2017 bikes are in recall 16V877 (fuel rail can leak). 2014 Chiefs are in recall 19V339 (headlight). 2014-2019 bikes are in recall 19V776 (gear position switch). Some 2014 Chiefs are also in recall 22V635 (headlight software).",
+   "reason": "A fuel leak is a fire risk. Every fix is free."
+  }
+ },
+ "add": [],
+ "lessons": {},
+ "recalls": [
+  {
+   "id": "16V446",
+   "years": "2014-2016 (some)",
+   "what": "An ignition misfire can overheat the exhaust and create a fire risk.",
+   "fix": "Free dealer repair.",
+   "src": "https://static.nhtsa.gov/odi/rcl/2016/RCLRPT-16V446-1614.PDF"
+  },
+  {
+   "id": "16V877",
+   "years": "2014-2017",
+   "what": "Fuel rail may leak fuel.",
+   "fix": "Free dealer repair.",
+   "src": "https://www.motorcyclistonline.com/indian-recalls-23746-late-model-motorcycles-for-potential-fuel-leak"
+  },
+  {
+   "id": "19V339",
+   "years": "2014",
+   "what": "Forward lighting may go out.",
+   "fix": "Free dealer repair.",
+   "src": "https://static.nhtsa.gov/odi/rcl/2019/RCONL-19V339-1937.pdf"
+  },
+  {
+   "id": "19V776",
+   "years": "2014-2019",
+   "what": "Gear position switch problem.",
+   "fix": "Free dealer repair.",
+   "src": "https://vehicleflaws.com/vehicle/indian/chieftain/2014"
+  },
+  {
+   "id": "22V635",
+   "years": "2014 Chief (some)",
+   "what": "Headlight control software problem.",
+   "fix": "Free dealer repair.",
+   "src": "https://auto-recalls.justia.com/indian/chief/2014/22v635000"
+  }
+ ],
+ "known": [],
+ "forums": [
+  {
+   "name": "HDForums",
+   "url": "https://www.hdforums.com/",
+   "what": "Large V-twin owner forum."
+  }
+ ],
+ "heroName": "CHIEF"
+}
