+   "id": "X-CB45-01",
+   "phase": "H",
+   "after": "H-003",
+   "title": "Check the torsion bar tension",
+   "instructions": "With the cam covers off, check each valve's torsion bar for equal tension when you remove and refit it. Replace any that are weak.",
+   "reason": "A torsion bar can lose strength if the engine sat for years with that valve held open.",
+   "src": "vintagehondatwins.com forum",
+   "safety": "Normal",
+   "skill": "Advanced",
+   "estHours": 2.0,
+   "tools": ""
+  }
+ ],
+ "lessons": {
+  "H": [
+   "Keep each torsion bar, follower and cam part with its own valve. Mixed-up valve gear is a common cause of bad Black Bomber engines."
+  ]
+ },
+ "recalls": [],
+ "recallNote": "Any recalls on bikes this old were closed long ago.",
+ "known": [
+  {
+   "title": "Tired torsion bars",
+   "what": "Bars can weaken on engines that sat with a valve open.",
+   "src": "https://www.vintagehondatwins.com/forums/goto/post?id=54856"
+  },
+  {
+   "title": "Mixed-up valve gear",
+   "what": "Swapped parts between valves cause problems.",
+   "src": "https://yewemmgee.blogspot.com/2010/12/honda-cb450-black-bomber.html"
+  }
+ ],
+ "forums": [
+  {
+   "name": "Vintage Honda Twins forum",
+   "url": "https://www.vintagehondatwins.com/",
+   "what": "Owner forum for CB/CL 350 and 450 twins."
+  }
+ ],
