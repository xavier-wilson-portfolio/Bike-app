+
+B95.append(mk("honda-gold-wing-2018-on-2018", "Honda", "Gold Wing (2018 on)", "Honda Gold Wing (2018 on)", [2018, 2026],
+  ["gold wing", "goldwing", "gl1800", "gold wing tour", "gl1800b", "gl1800d", "gold wing dct", "gold wing 2018"], "touring", "shaft",
