+B48.append(mk("bsa-gold-star-dbd34-1938", "BSA", "Gold Star", "BSA Gold Star", [1938, 1963],
+  ["gold star", "goldie", "dbd34", "db34", "bsa gold star", "cb34", "zb32"], "standard", "chain",
