+  EFI, GENNOTE, [BUELLF]))
+
+B99.append(mk("baja-motorsports-doodle-bug-mb165-minibike-2006", "Baja Motorsports", "Doodle Bug / MB165 minibike", "Baja Doodle Bug / MB165", [2006, 2019],
