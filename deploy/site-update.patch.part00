+   "years": "2014",
+   "what": "A resin bracket inside the fuel pump can swell and jam the impeller, so the engine can stall.",
+   "fix": "Dealer replaces the fuel pump free.",
+   "src": "https://vehiclesafetyrecalls.com/recall/14V672000"
+  },
+  {
+   "id": "16V661",
+   "years": "2014-2015 (some)",
+   "what": "Fuel pump can seize and stop fuel flow, so the engine stalls.",
+   "fix": "Dealer replaces the fuel pump free.",
+   "src": "https://static.nhtsa.gov/odi/rcl/2016/RCRIT-16V661-0493.pdf"
+  },
+  {
+   "id": "16V109",
+   "years": "2014 (Jun-Sep 2013 build)",
+   "what": "Rear brake line joint may not be torqued right and can leak fluid.",
+   "fix": "Dealer checks and fixes the joint free.",
+   "src": "https://vehiclesafetyrecalls.com/recall/16V109000"
+  },
+  {
+   "id": "15V439",
+   "years": "2014-2015 (model list varies)",
+   "what": "Starter relay switch can fail, so the bike may not start, or the starter may keep running.",
+   "fix": "Dealer replaces the starter relay free.",
