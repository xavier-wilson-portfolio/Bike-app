+   "phase": "H",
+   "after": "H-003",
+   "title": "Check the rocker shafts and cam",
+   "instructions": "With the valve cover off, check that the rocker shafts can't turn in the cover and look for wear in their sockets and on the cam lobes. Later shafts screw in to stop this.",
+   "reason": "Early CB360s used loose rocker shafts that could rotate and wear the cover.",
+   "src": "CB360 history notes",
+   "safety": "Normal",
+   "skill": "Advanced",
+   "estHours": 1.5,
+   "tools": ""
+  }
+ ],
+ "lessons": {
+  "H": [
+   "A clutch cable outer that's a few mm too long makes the clutch fussy to adjust. Check it before you blame the clutch."
+  ]
+ },
+ "recalls": [],
+ "recallNote": "Any recalls on bikes this old were closed long ago.",
+ "known": [
+  {
+   "title": "Loose rocker shafts",
+   "what": "Early shafts could rotate and wear the head cover.",
+   "src": "https://carolusmixedup.blogspot.com/2015/07/start-restore-my-cb-360.html"
+  },
+  {
+   "title": "Long clutch cables",
+   "what": "Many replacement cables are about 4 mm too long.",
+   "src": "https://www.vintagehondatwins.com/forums/goto/post?id=202608"
+  }
+ ],
+ "forums": [
+  {
+   "name": "Vintage Honda Twins forum",
+   "url": "https://www.vintagehondatwins.com/",
+   "what": "Owner forum for Honda twins of the 60s and 70s."
+  }
+ ],
+ "silhouette": "honda-cb360-1974",
