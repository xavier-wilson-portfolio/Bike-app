+  {
+   "id": "X-T14-01",
+   "phase": "H",
+   "after": "H-001",
+   "title": "Clean the oil tank in the frame",
+   "instructions": "Drain the frame oil tank and flush out sludge. Check the strainer. If the frame was blasted, make sure no grit is left inside.",
+   "reason": "Sludge or blast grit in the frame tank goes straight into the engine.",
+   "src": "Motorcycle Classics oil-in-frame notes",
+   "safety": "Normal",
+   "skill": "Intermediate",
+   "estHours": 1.5,
+   "tools": ""
+  }
+ ],
+ "lessons": {
+  "H": [
+   "Bikes that stood for decades usually have hard seals and corroded internals. Plan on a full engine rebuild."
+  ]
+ },
+ "recalls": [],
+ "recallNote": "Any recalls on bikes this old were closed long ago.",
+ "known": [
+  {
+   "title": "Long storage",
+   "what": "Hard oil seals and corroded engine and gearbox internals are common on bikes that sat for years.",
+   "src": "https://www.pressreader.com/uk/classic-bike-uk/20180901/282862256737502"
+  }
+ ],
+ "forums": [],
