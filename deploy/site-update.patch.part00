+  TWO, OLD, [VJMC], lessons={"B": [SLUBE, POINTS]}))
+
+B64.append(mk("kawasaki-w1-w2-650-1966", "Kawasaki", "W1 / W2 650", "Kawasaki W1 / W2 650", [1966, 1971],
