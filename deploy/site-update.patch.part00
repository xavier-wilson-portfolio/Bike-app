+  "H-004"
+ ],
+ "patch": {},
+ "add": [
+  {
+   "id": "X-SR5-01",
+   "phase": "H",
+   "after": "H-003",
+   "title": "Check the decompressor",
+   "instructions": "Make sure the decompression lever cable has a little free play and the valve opens and closes cleanly.",
+   "reason": "A worn or misadjusted decompressor makes the bike hard to kick and can cause kickback.",
+   "src": "Motoryk SR500 notes",
+   "safety": "Normal",
+   "skill": "Intermediate",
+   "estHours": 0.5,
+   "tools": ""
+  }
+ ],
+ "lessons": {
+  "B": [
+   "Starting routine: choke on, pull the decompressor, ease the kickstarter until the silver mark shows in the window, release the lever, then give one full kick."
+  ]
+ },
+ "recalls": [],
+ "recallNote": "Any recalls on bikes this old were closed long ago.",
+ "known": [
+  {
+   "title": "Hard starting",
+   "what": "Tight exhaust valves and a worn decompressor are common causes.",
+   "src": "https://motoryk.com/bikes/yamaha/sr500"
+  }
+ ],
+ "forums": [],
+ "heroName": "SR500"
+}
