+ "remove": [
+  "G-004",
+  "H-004"
+ ],
+ "patch": {},
+ "add": [
+  {
+   "id": "X-IRON-01",
+   "phase": "E",
+   "after": "E-002",
+   "title": "Check the engine cases",
+   "instructions": "Look for cracks, stripped threads and broken bolts in the cases. On pre-1973 cases, check the lower right transmission area near the speedometer drive.",
+   "reason": "Cracked or mismatched cases cause leaks and gearbox trouble.",
+   "src": "Classic Motorcycle Build Ironhead notes",
+   "safety": "Normal",
+   "skill": "Intermediate",
+   "estHours": 1.0,
+   "tools": ""
+  }
+ ],
+ "lessons": {
+  "A": [
+   "Many Ironheads have had several owners who skimped on parts. Check what has been changed before you trust anything."
+  ]
+ },
+ "recalls": [],
+ "recallNote": "Any recalls on bikes this old were closed long ago.",
+ "known": [
+  {
+   "title": "Engine cases",
+   "what": "Early cases crack near the speedometer drive, and mismatched cases cause gearbox wear.",
+   "src": "https://www.classic-motorcycle-build.com/ironhead-engine-cases.html"
+  }
+ ],
+ "forums": [],
+ "heroName": "IRONHEAD"
+}
