+   "id": "20V146",
+   "years": "2020 (some)",
+   "what": "Emergency stop signal can make the brake light flash instead of staying on.",
+   "fix": "Dealer reprograms the emergency stop signal free.",
+   "src": "https://auto-recalls.justia.com/bmw/f850gs/2020/20v146000"
+  },
+  {
+   "id": "22V752",
+   "years": "2022",
+   "what": "Clutch cover bolts were not lubricated, so the cover can loosen and leak oil.",
+   "fix": "Free dealer repair.",
+   "src": "https://vehiclesafetyrecalls.com/recall/22V752000"
+  },
+  {
+   "id": "23V123",
+   "years": "2023 (some)",
