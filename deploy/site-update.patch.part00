+B74.append(mk("triumph-tr25w-trophy-250-blazer-1968", "Triumph", "TR25W Trophy 250 / Blazer", "Triumph TR25W Trophy 250", [1968, 1970],
+  ["tr25w", "trophy 250", "blazer", "tr25", "blazer ss", "t25"], "standard", "chain",
