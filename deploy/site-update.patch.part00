+ "patch": {},
+ "add": [
+  {
+   "id": "X-A65-01",
+   "phase": "B",
+   "after": "B-004",
+   "title": "Check the bottom end before a full rebuild",
+   "instructions": "Check oil pressure and listen for knocking at the timing side. Ask about the timing-side main bush and whether it has been converted to a bearing.",
+   "reason": "The A65's timing-side plain bush is a known weak point when worn.",
+   "src": "Classic BSA practice",
+   "safety": "Normal",
+   "skill": "Advanced",
+   "estHours": 1.0,
+   "tools": ""
+  }
+ ],
+ "lessons": {
+  "G": [
+   "Lightnings run twin Amals. Thunderbolts run one. Check what you have before buying parts."
