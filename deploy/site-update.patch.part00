+B66.append(mk("suzuki-tm250-tm400-cyclone-1971", "Suzuki", "TM250 / TM400 Cyclone", "Suzuki TM250 / TM400 Cyclone", [1971, 1975],
+  ["tm250", "tm400", "cyclone", "tm 400", "tm 250", "tm125", "tm100", "tm400 cyclone"], "dualsport", "chain",
