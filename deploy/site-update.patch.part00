+ "patch": {
+  "A-002": {
+   "title": "Check for open recalls",
+   "instructions": "Run your VIN at nhtsa.gov/recalls. 2005 and 2006 C50s were recalled for the ignition switch, and Suzuki said not to ride them until it was replaced.",
+   "reason": "A failing ignition switch can shut the engine off while riding."
+  }
+ },
+ "add": [],
+ "lessons": {
+  "F": [
+   "A battery that keeps dying often points to a failing regulator/rectifier or loose battery leads. Test charging voltage at idle and 5,000 rpm."
+  ]
+ },
+ "recalls": [],
+ "recallNote": "No recalls found for these years when this course was written. Run your VIN at nhtsa.gov/recalls to be sure.",
+ "known": [
