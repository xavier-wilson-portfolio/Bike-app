+   "title": "Charging",
+   "what": "Stator and regulator/rectifier failures cause dim lights and dead batteries.",
+   "src": "https://enginepatrol.com/suzuki-boulevard-c50-c50t-common-problems/"
+  }
+ ],
+ "forums": [],
+ "silhouette": "suzuki-boulevard-c50-2005",
