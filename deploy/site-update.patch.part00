+  [], DIRTNOTE, [TT]))
+
+B55.append(mk("honda-crf125f-2014", "Honda", "CRF125F", "Honda CRF125F", [2014, 2026],
+  ["crf125f", "crf125", "crf 125", "crf 125f", "crf125fb"], "dualsport", "chain",
+  "124 cc air-cooled four-stroke single, carb then fuel injection, four-speed",
