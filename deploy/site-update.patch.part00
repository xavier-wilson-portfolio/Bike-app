+  [["Pre-unit twin", "Air-cooled"], ["Carb", "Clean it out"], ["Magneto", "Check spark"], ["Gearbox", "Separate oil"], ["Parts", "Source early"]],
+  CARB, OLD, [TRF], lessons={"K": [PREUNIT]}))
