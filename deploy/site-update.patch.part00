+B60.append(mk("yamaha-xsr900-2016-2021-2016", "Yamaha", "XSR900 (2016-2021)", "Yamaha XSR900 (2016-2021)", [2016, 2021],
+  ["xsr900", "xsr 900", "xsr-900", "xsr900 abarth"], "standard", "chain",
