+"""Batch 17 bike tunes (top 500, rows 161-170)."""
+from batch2 import step, CARB, EFI, AIR, OLD, VIN
+B17 = []
+SVR = dict(name="SVRider forum", url="https://www.svrider.com/", what="Owner forum for the Suzuki SV650 and SV1000.")
