+  EFI, HUSKNOTE, [ADVR]))
+
+B49.append(mk("ural-gear-up-ct-sidecar-2001", "Ural", "Gear Up / CT / Patrol (sidecar)", "Ural sidecar rigs (Gear Up, CT, Patrol)", [2001, 2026],
