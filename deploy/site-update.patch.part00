+   "id": "X-YZ25-01",
+   "phase": "G",
+   "after": "G-004",
+   "title": "Check compression and the top end",
+   "instructions": "Do a compression test. Low numbers mean the piston and rings are due. Pull and clean the power valve while you are in there.",
+   "reason": "A tired top end and a gummed power valve are the most common problems on a used two-stroke.",
+   "src": "Two-stroke basics",
+   "safety": "Normal",
+   "skill": "Intermediate",
+   "estHours": 1.5,
+   "tools": ""
+  }
+ ],
+ "lessons": {
