+   "url": "https://forums.bmwmoa.org/",
+   "what": "BMW Motorcycle Owners of America forum."
+  }
+ ],
+ "silhouette": "bmw-k1200lt-1999",
+ "areas": [],
+ "heroName": "K1200LT"
+}
