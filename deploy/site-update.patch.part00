+  TWO, OLD, [TRIALS], lessons={"B": [PREMIX]}))
+
+HERO_NAME_B83 = {"gasgas-ec-250-300-spanish-2000": "EC 300", "gasgas-txt-trials-1995": "TXT", "gasgas-mc-ex-2021-on-2021": "GASGAS",
