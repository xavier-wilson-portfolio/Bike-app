+   "id": "X-KS-01",
+   "phase": "G",
+   "after": "G-004",
+   "title": "Check the oil injection pump",
+   "instructions": "Make sure the oil tank feeds the pump, bleed the lines, and check the pump cable so it opens with the throttle.",
+   "reason": "A two-stroke with no oil supply seizes quickly.",
+   "src": "Two-stroke basics",
+   "safety": "Normal",
+   "skill": "Intermediate",
+   "estHours": 1.0,
+   "tools": ""
+  }
+ ],
+ "lessons": {
+  "B": [
+   "A two-stroke with leaking crank seals runs lean and can seize. Get the seals checked before riding hard."
+  ]
+ },
+ "recalls": [],
+ "recallNote": "Any recalls on bikes this old were closed long ago.",
+ "known": [],
+ "forums": [
+  {
+   "name": "Kawasaki Triples Club",
+   "url": "https://www.kawasakitriples.com/",
+   "what": "Club and forum for Kawasaki two-stroke triples."
+  }
+ ],
+ "heroName": "KH400"
