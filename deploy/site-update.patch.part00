+  TWO, OLD, [TT], lessons={"B": [PREMIX]}))
+
+B83.append(mk("ossa-pioneer-stiletto-mar-1967", "Ossa", "Pioneer / Stiletto / MAR", "Ossa Pioneer / Stiletto / MAR", [1967, 1982],
