+  [["Freedom V-twin", "Air/oil cooled"], ["Fuel injected", "No carbs"], ["Bodywork", "Many panels"], ["Belt drive", "Check wear"], ["Parts", "Brand ended 2017"]],
+  EFI, POLNOTE, [VICF]))
