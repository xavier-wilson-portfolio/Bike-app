+   "phase": "G",
+   "after": "G-004",
+   "title": "Check compression and the top end",
+   "instructions": "Do a compression test. Low or uneven numbers mean the piston and rings are due. Look at the piston through the exhaust port for scoring.",
+   "reason": "A tired top end is the most common problem on a used two-stroke motocross bike.",
+   "src": "Two-stroke basics",
+   "safety": "Normal",
+   "skill": "Intermediate",
+   "estHours": 1.0,
+   "tools": ""
+  }
+ ],
+ "lessons": {
+  "B": [
+   "It runs on premix. Mix the oil into the fuel at the ratio in the manual. There is no oil tank."
+  ]
+ },
