+  "kawasaki-ltd-450-en450-1985": "454 LTD", "suzuki-tm250-tm400-cyclone-1971": "CYCLONE", "suzuki-rm125-1975": "RM125", "suzuki-rm80-rm85-1977": "RM85"}
