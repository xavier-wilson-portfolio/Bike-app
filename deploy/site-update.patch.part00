+  "A-002": {
+   "title": "Check for open recalls",
+   "instructions": "Run your VIN at nhtsa.gov/recalls. Recall 11V567 covered rear brake drag on many 2001-2010 and 2012-2015 GL1800s. Airbag-equipped bikes from 2006-2016 had inflator recalls (16V347, 17V031, 18V045). Book any open recall with a Honda dealer.",
+   "reason": "Brake drag can overheat the rear brake, and airbag inflators can fail dangerously. Both repairs are free."
+  }
+ },
+ "add": [],
+ "lessons": {
+  "K": [
+   "The front and rear brakes are linked through a secondary master cylinder. Follow the manual's bleed order."
+  ]
+ },
+ "recalls": [
+  {
+   "id": "11V567",
+   "years": "2001-2010, 2012-2015",
+   "what": "Rear brake may drag after release.",
+   "fix": "Free dealer repair of the secondary master cylinder.",
+   "src": "https://www.rideapart.com/news/253890/honda-recalls-certain-gl1800-models/"
+  },
+  {
+   "id": "18V045",
+   "years": "2009-2010, 2012-2016 (airbag)",
+   "what": "Airbag inflator may explode.",
+   "fix": "Dealer replaces the airbag module free.",
+   "src": "https://vehiclesafetyrecalls.com/recall/18V045000"
+  }
+ ],
+ "known": [],
+ "forums": [],
+ "silhouette": "honda-gold-wing-gl1800-2001",
+ "areas": [],
+ "heroName": "GOLD WING",
