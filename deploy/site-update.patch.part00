+  "yz250 two stroke",
+  "yz250 2 stroke"
+ ],
+ "style": "dualsport",
+ "drive": "chain",
+ "engine": "249 cc two-stroke single, carb, premix",
+ "intro": "Yamaha's long-running 250 two-stroke. Premix, a top end that wears and no lights.",
+ "focus": [
+  [
+   "Two-stroke",
+   "Premix"
+  ],
+  [
+   "Top end",
+   "Check compression"
+  ],
