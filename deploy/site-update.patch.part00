+  "G-001": {
+   "title": "Find out which fuel system it has",
+   "instructions": "2004-2009 Shadow 750s use a carburetor. 2010 and later are fuel injected. Do the carb steps or the fuel injection check to match.",
+   "reason": "The fuel steps are different for each."
+  }
+ },
+ "add": [],
+ "lessons": {},
+ "recalls": [
+  {
+   "id": "15V874",
+   "years": "2010-2016",
+   "what": "Bank angle sensor wire can rub through and stall the engine.",
+   "fix": "Dealer relocates the connector and replaces the sensor free.",
+   "src": "https://incompliancemag.com/honda-recalls-vt750-motorcycles-for-electrical-system-defect/"
+  }
+ ],
+ "known": [],
