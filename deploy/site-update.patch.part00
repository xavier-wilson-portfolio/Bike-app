+  "artist": "Heselnut",
+  "page": "https://commons.wikimedia.org/wiki/File:2015_Suzuki_GSX-R600.jpg",
+  "lic": "CC BY-SA 4.0",
+  "licUrl": "https://creativecommons.org/licenses/by-sa/4.0"
+ }
