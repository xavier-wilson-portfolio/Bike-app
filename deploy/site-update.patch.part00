+  TWO, OLD, [KZR], lessons={"B": [SLUBE, POINTS]}))
+
+B64.append(mk("kawasaki-a1-samurai-a7-avenger-1966", "Kawasaki", "A1 Samurai / A7 Avenger", "Kawasaki A1 Samurai / A7 Avenger", [1966, 1971],
