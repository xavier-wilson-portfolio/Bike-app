+   "src": "https://au7o.io/motorcycle-issues/honda-cbr600rr?year=2012"
+  }
+ ],
+ "known": [
+  {
+   "title": "Regulator/rectifier",
+   "what": "Can overheat and burn out, killing the battery.",
+   "src": "https://enginepatrol.com/honda-cbr600rr-common-problems/"
+  }
+ ],
