+B84.append(mk("matchless-g80-ajs-model-18-single-1945", "Matchless", "G80 / AJS Model 18 single", "Matchless G80 / AJS Model 18", [1945, 1966],
+  ["g80", "g80s", "model 18", "ajs 18", "g3", "g3l", "ajs 16", "matchless g80", "g80cs"], "standard", "chain",
