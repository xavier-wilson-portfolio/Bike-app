+ "remove": [
+  "G-004"
+ ],
+ "patch": {
+  "A-002": {
+   "title": "Check for open recalls",
+   "instructions": "Run your VIN at nhtsa.gov/recalls. 2004-2013 GSX-R600s were in recall 13V449 for front brake master cylinder corrosion.",
+   "reason": "A corroded piston gives a soft lever and longer stops. The repair is free."
+  }
+ },
+ "add": [],
+ "lessons": {
+  "E": [
+   "Check the frame spars, subframe and fairing mounts for scrapes and cracks. Track and street crashes are common on these."
+  ]
+ },
+ "recalls": [
+  {
+   "id": "13V449",
+   "years": "2004-2013",
+   "what": "Front brake master cylinder piston can corrode, giving a soft lever.",
+   "fix": "Dealer replaces the master cylinder parts free.",
+   "src": "https://vehiclesafetyrecalls.com/recall/13V449000"
+  }
+ ],
+ "known": [],
+ "forums": [],
+ "silhouette": "suzuki-gsx-r600-2011",
+ "areas": [],
+ "heroName": "GSX-R600",
