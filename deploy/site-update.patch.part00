+   "id": "04V438",
+   "years": "2005 (some)",
+   "what": "Anti-theft control unit problem that affects the fuel pump.",
+   "fix": "Dealer inspects and replaces the anti-theft control unit free.",
+   "src": "https://auto-recalls.justia.com/bmw/k1200-lt/2005/04v438000"
+  }
+ ],
+ "recallNote": "BMW has issued several recalls across these years. Run your VIN at nhtsa.gov/recalls before you start.",
+ "known": [],
+ "forums": [
