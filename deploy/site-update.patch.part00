+  [["Single", "Liquid-cooled"], ["Carb", "Clean it out"], ["Valves", "Shim check"], ["Cooling", "Coolant and hoses"], ["Chain drive", "Slack and lube"]],
+  CARB, GENNOTE, [TT]))
