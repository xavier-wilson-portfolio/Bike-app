--- /dev/null
+++ b/data/tunes/triumph-bonneville-t120-2016.json
@@ -0,0 +1,73 @@
+{
+ "id": "triumph-bonneville-t120-2016",
+ "make": "Triumph",
+ "model": "Bonneville T120",
+ "name": "Triumph Bonneville T120",
+ "years": [
+  2016,
+  2026
+ ],
+ "match": [
+  "t120",
+  "bonneville t120",
+  "bonneville",
+  "t120 black"
+ ],
+ "style": "standard",
+ "drive": "chain",
+ "engine": "1200 cc liquid-cooled parallel twin, fuel injected",
+ "intro": "The modern liquid-cooled Bonneville. Several recalls, so run the VIN first.",
+ "focus": [
+  [
+   "1200 cc twin",
+   "Liquid-cooled"
+  ],
+  [
+   "Fuel injected",
+   "Looks like carbs"
+  ],
+  [
+   "Recalls",
+   "Several by year"
+  ],
+  [
+   "Chain drive",
+   "Slack and lube"
+  ],
+  [
+   "Clutch cable",
+   "Check routing"
+  ]
+ ],
+ "remove": [
+  "G-004"
+ ],
+ "patch": {
+  "A-002": {
+   "title": "Check for open recalls",
+   "instructions": "Run your VIN at nhtsa.gov/recalls. T120 recalls include sticking throttle with heated grips (2016-2017, 17V035), clutch cable routing (2016-2019, 19V133), a loose left front brake disc (2023, 23V146) and a wiring and charging recall (2022-2024, 26V078).",
+   "reason": "Several of these affect brakes or throttle. Repairs are free."
+  }
+ },
+ "add": [],
+ "lessons": {},
+ "recalls": [
+  {
+   "id": "23V146",
+   "years": "2023 (some)",
+   "what": "Left front brake disc may be loose and can detach.",
+   "fix": "Dealer replaces the damper and disc bolts free.",
+   "src": "https://www.rideapart.com/news/657649/triumph-bonneville-t120-recall-2023/"
+  },
+  {
+   "id": "17V035",
+   "years": "2016-2017 with heated grips",
+   "what": "Heated grips can expand and make the throttle stick open.",
+   "fix": "Free dealer repair.",
+   "src": "https://www.motorcyclistonline.com/triumph-recalls-2016-2017-bonneville-t120-for-sticking-throttle-issue"
+  }
+ ],
+ "known": [],
+ "forums": [],
+ "heroName": "T120"
+}
