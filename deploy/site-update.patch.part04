+"kawasaki-klr650-gen2":dict(rect=(7,2,98,97),bg=[(0,0,24,29),(43,0,100,27),(36,90,52,100),(0,30,8,100)],fg=[(42,55,55,70),(58,38,74,46)]),
+"honda-rebel-500":dict(rect=(14,5,99,97),pf=[(16,45,27,54)],bg=[(0,0,16,50),(16,0,25,44),(44,0,100,17),(50,17,100,37),(41,17,50,26.5),(78,36,100,45),(37,82,52,100),(52,78,64,100),(85,84,100,100),(0,80,15,100),(0,88,48,100)],fg=[(36,33,47,42),(40,52,52,62),(60,42,70,48),(56,52,63,62)]),
+"honda-cb750-sohc":dict(rect=(6,18,99,95),bg=[],fg=[]),
+"honda-cb550-four-1974":dict(rect=(1,4,96,92),bg=[(0,0,20,15),(46,0,100,17),(0,89,100,100),(0,30,3,45)],fg=[(40,42,60,65),(35,25,50,35)]),
+"honda-rebel-1100-2021":dict(rect=(2,10,95,86),bg=[(0,0,100,9),(45,9,100,40),(0,0,21,45),(0,84,100,100),(91,40,100,80)],fg=[(35,45,55,65),(52,42,68,52)]),
+"honda-cb500-four-1971":dict(rect=(19,45,81,96),bg=[(0,0,100,46),(0,91,42,100),(82,40,100,100),(0,45,18,100)],fg=[(43,62,57,77),(28,59,40,64)]),
+"honda-cb400f-super-sport-1975":dict(rect=(1,1,99,92),bg=[(0,0,100,12),(0,12,18,22),(36,12,57,25),(0,85,100,100),(94,40,100,70)],fg=[(35,48,55,68),(30,28,52,42),(55,32,85,40)]),
+"honda-cbr600rr-2007":dict(rect=(7,4,98,92),bg=[(0,0,17,30),(40,0,100,17),(0,35,12,85),(0,93,100,100),(90,55,100,90)],fg=[(40,45,60,70),(55,30,65,38)]),
+"honda-cb450-1965":dict(rect=(1,1,99,99),bg=[(20,0,57,30),(68,0,100,25),(0,0,18,30),(0,94,30,100),(43,93,63,100),(97,0,100,100)],fg=[(45,50,58,70),(18,35,38,45)]),
+"honda-cbr500r-2013":dict(rect=(14,10,83,96),bg=[(0,0,22,100),(0,0,100,9),(42,0,100,25),(83,0,100,100),(0,96,100,100),(62,80,82,100)],fg=[(40,35,55,60),(55,40,65,48)]),
+}
+meta=json.load(open('meta.json'))
+OLD={'honda-cb750-sohc','honda-rebel-500','kawasaki-kz650','yamaha-mt07-gen1','yamaha-xs650','kawasaki-ninja-400','suzuki-gs550','harley-street-glide-m8','honda-cb350-twin','kawasaki-klr650-gen2'}
+def box(m,b,W,Hh,v): x0,y0,x1,y1=b; m[int(y0*Hh/100):int(y1*Hh/100),int(x0*W/100):int(x1*W/100)]=v
+for i in (sys.argv[1:] or list(H)):
+    h=H[i]; fn=meta.get(i,{}).get('photo',f'revora-photo-{i}.jpg')
+    import os; p='/tmp/bp/photos/'+i+'.jpg'; im=cv2.imread(p if os.path.exists(p) and i not in OLD else '/mnt/user-data/uploads/Downloads/'+fn); hh,ww=im.shape[:2]
+    s=cv2.resize(im,(1400,int(hh*1400/ww))); Hh,W=s.shape[:2]
+    m=np.full((Hh,W),cv2.GC_BGD,np.uint8); box(m,h['rect'],W,Hh,cv2.GC_PR_FGD)
+    for b in h['bg']: box(m,b,W,Hh,cv2.GC_BGD)
+    for b in h.get('pf',[]): box(m,b,W,Hh,cv2.GC_PR_FGD)
+    for b in h['fg']: box(m,b,W,Hh,cv2.GC_FGD)
+    # tires: the photo outside the bottom half of each tire is ground (background); the tire itself is probably bike
+    from wfit import WH
+    yy,xx=np.mgrid[0:Hh,0:W]
+    for c in WH.get(i,[]):
+        cx,cy,rx=c[:3]; ry=c[3] if len(c)>3 else rx; top=c[4] if len(c)>4 else -2
+        X,Y,RX,RY=cx*W/100,cy*Hh/100,rx*W/100,ry*W/100
+        d=np.sqrt(((xx-X)/RX)**2+((yy-Y)/RY)**2)
+        m[(d>1.07)&(yy>Y+RY*0.25)&(np.abs(xx-X)<RX*1.3)]=cv2.GC_BGD
+        ring=(d<=0.99)&(d>0.80)&(yy>Y+RY*max(top,-1))
+        m[ring&(m!=cv2.GC_FGD)]=cv2.GC_PR_FGD
+    bg=np.zeros((1,65)); fg=np.zeros((1,65))
+    cv2.grabCut(s,m,None,bg,fg,8,cv2.GC_INIT_WITH_MASK)
+    mk=np.where((m==1)|(m==3),255,0).astype(np.uint8)
+    # keep the largest blob (the bike) and fill small holes in it
+    n,lab,st,_=cv2.connectedComponentsWithStats(mk); big=st[1:,4].max(); mk=np.isin(lab,[k for k in range(1,n) if st[k,4]>=big*0.03]).astype(np.uint8)*255
+    np.save(f'mask-{i}.npy',mk); cv2.imwrite(f'scaled-{i}.jpg',s)
+    v=s.copy(); v[mk==0]=(v[mk==0]*0.25+np.array([0,0,180])*0.75).astype(np.uint8); cv2.imwrite(f'chk-{i}.jpg',cv2.resize(v,(700,int(Hh*700/W))))
+    print(i)
diff --git a/tools/silhouettes/hero.py b/tools/silhouettes/hero.py
new file mode 100644
index 0000000..1d1d852
--- /dev/null
+++ b/tools/silhouettes/hero.py
@@ -0,0 +1,56 @@
+import cv2, numpy as np, json, sys
+from PIL import Image, ImageDraw, ImageFont, ImageFilter
+NAVY=(23,35,44); TAN=(217,191,142); LB=(185,217,235)
+FD='/usr/share/fonts/opentype/inter/'
+W,H=1200,660
+meta=json.load(open('meta.json'))
+def cutout(i):
+    s=cv2.imread(f'scaled-{i}.jpg'); m=np.load(f'mask-{i}.npy').astype(np.float32)/255
+    m=cv2.GaussianBlur(m,(0,0),1.6)
+    ys,xs=np.where(m>0.5); x0,x1,y0,y1=xs.min(),xs.max(),ys.min(),ys.max()
+    rgba=np.dstack([cv2.cvtColor(s,cv2.COLOR_BGR2RGB),(m*255).astype(np.uint8)])[y0:y1+1,x0:x1+1]
+    return Image.fromarray(rgba,'RGBA')
+def photo(i):
+    return Image.open('scaled-'+i+'.jpg').convert('RGB')
+def cover(img,w,h):
+    k=max(w/img.width,h/img.height); img=img.resize((int(img.width*k),int(img.height*k)),Image.LANCZOS)
+    x=(img.width-w)//2; y=(img.height-h)//2; return img.crop((x,y,x+w,y+h))
+def credit(d,i,fill=(255,255,255,150)):
+    m=meta[i]; d.text((W-16,H-14),f"Photo: {m['artist']}, {m['lic']}",font=ImageFont.truetype(FD+'Inter-Medium.otf',15),fill=fill,anchor='rs')
+def name_card(i,big,label):
+    bg=Image.new('RGB',(W,H),NAVY); g=np.zeros((H,W,3),np.float32)
+    yy,xx=np.mgrid[0:H,0:W]; r=np.sqrt(((xx-W*0.55)/W)**2+((yy-H*0.45)/H)**2)
+    g=np.clip(1-r*1.6,0,1)[...,None]*np.array([30,45,58])
+    bg=Image.fromarray(np.clip(np.array(bg,np.float32)+g,0,255).astype(np.uint8))
+    d=ImageDraw.Draw(bg,'RGBA')
+    f=ImageFont.truetype(FD+'InterDisplay-Black.otf',300); tw=d.textlength(big,font=f)
+    if tw>W*0.95: f=ImageFont.truetype(FD+'InterDisplay-Black.otf',int(300*W*0.95/tw))
+    d.text((W/2,H*0.40),big,font=f,fill=TAN+(70,),anchor='mm')
+    c=cutout(i); k=min(W*0.84/c.width,H*0.74/c.height); c=c.resize((int(c.width*k),int(c.height*k)),Image.LANCZOS)
+    x=(W-c.width)//2; y=int(H*0.9)-c.height
+    sh=Image.new('RGBA',(W,H),(0,0,0,0)); ImageDraw.Draw(sh).ellipse((x+c.width*0.08,y+c.height-18,x+c.width*0.92,y+c.height+22),fill=(0,0,0,150))
+    bg=Image.alpha_composite(bg.convert('RGBA'),sh.filter(ImageFilter.GaussianBlur(14)))
+    bg.alpha_composite(c,(x,y))
+    d=ImageDraw.Draw(bg); d.text((28,28),label,font=ImageFont.truetype(FD+'Inter-Bold.otf',22),fill=LB)
+    credit(d,i); return bg.convert('RGB')
+def duotone(i,label):
+    p=cover(photo(i),W,H); L=np.array(p.convert('L'),np.float32)/255
+    L=np.clip((L-0.08)/0.84,0,1)
+    a=np.array(NAVY,np.float32)*0.55; b=np.array(TAN,np.float32)*1.0+np.array([20,20,20])
+    img=a+(b-a)*L[...,None]**1.1
+    yy,xx=np.mgrid[0:H,0:W]; v=np.clip(1-((xx/W-0.55)**2*1.2+(yy/H-0.5)**2*1.6),0.35,1)[...,None]; img=img*v
+    out=Image.fromarray(np.clip(img,0,255).astype(np.uint8)); d=ImageDraw.Draw(out)
+    d.text((28,28),label,font=ImageFont.truetype(FD+'Inter-Bold.otf',22),fill=(255,255,255)); credit(d,i); return out
+def film(i,label):
+    p=np.array(cover(photo(i),W,H),np.float32)
+    p=(p-128)*1.08+128; p[...,0]*=1.04; p[...,2]*=0.94   # a touch of contrast and warmth
+    lum=p.mean(2,keepdims=True); p=lum+(p-lum)*0.85
+    yy,xx=np.mgrid[0:H,0:W]; fade=np.clip((xx/W-0.0)/0.45,0,1)[...,None]
+    p=np.array(NAVY,np.float32)*(1-fade)+p*fade
+    p+=np.random.default_rng(1).normal(0,7,p.shape)
+    bar=int(H*0.07); p[:bar]=0; p[-bar:]=0
+    out=Image.fromarray(np.clip(p,0,255).astype(np.uint8)); d=ImageDraw.Draw(out)
+    d.text((28,bar+22),label,font=ImageFont.truetype(FD+'Inter-Bold.otf',22),fill=TAN); credit(d,i); return out
+if __name__=='__main__':
+    for i,big,label in [("honda-cb750-sohc","CB750","1975 HONDA CB750"),("harley-street-glide-m8","GLIDE","2019 HARLEY-DAVIDSON STREET GLIDE")]:
+        name_card(i,big,label).save(f'hero-A-{i}.png'); duotone(i,label).save(f'hero-B-{i}.png'); film(i,label).save(f'hero-C-{i}.png')
diff --git a/tools/silhouettes/hero_lib.py b/tools/silhouettes/hero_lib.py
new file mode 100644
index 0000000..1c95716
--- /dev/null
+++ b/tools/silhouettes/hero_lib.py
@@ -0,0 +1,73 @@
+import numpy as np, json, cv2
+from PIL import Image, ImageDraw, ImageFont, ImageFilter
+import hero as _h
+from hero import cover, meta, FD
+W, H = _h.W, _h.H
+BLUE=(141,187,216)
+TAN_MIX=0.68
+def grade(p):
+    p=np.array(p,np.float32)/255
+    p=np.clip((p-0.06)/0.92,0,1)**1.22                     # crush the blacks a little
+    lum=p.mean(2,keepdims=True); p=lum+(p-lum)*0.78         # pull saturation back
+    sh=(1-lum)**2; p=p+sh*np.array([-0.035,0.04,0.075])      # teal shadows
+    hl=lum**2; p=p+hl*np.array([0.035,0.015,-0.02])         # warm highlights
+    yy,xx=np.mgrid[0:p.shape[0],0:p.shape[1]]
+    v=1-0.45*(((xx/p.shape[1]-0.5)*1.25)**2+((yy/p.shape[0]-0.5)*1.5)**2); p*=np.clip(v,0.5,1)[...,None]
+    p+=np.random.default_rng(1).normal(0,0.018,p.shape)
+    return Image.fromarray(np.clip(p*255,0,255).astype(np.uint8))
+def tan(img):
+    a=np.array(img.convert('RGB'),np.float32)/255; lum=(a@np.array([0.3,0.59,0.11]))[...,None]
+    tone=np.array([23,35,44])/255*0.6+(np.array([240,212,160])/255-np.array([23,35,44])/255*0.6)*lum
+    a=a*(1-TAN_MIX)+tone*TAN_MIX
+    return Image.fromarray(np.clip(a*255,0,255).astype(np.uint8))
+FRONT=False
+MAXTOP=0.35   # more than this hidden at the top and the name goes to the bottom, in front
+def hero(i,big,label,year=""):
+    global W,H
+    W,H=_h.W,_h.H
+    s=Image.open(f'scaled-{i}.jpg').convert('RGB'); m=np.load(f'mask-{i}.npy').astype(np.float32)
+    m=cv2.GaussianBlur(m,(0,0),1.4)
+    k=max(W/s.width,H/s.height); sw,shh=int(s.width*k),int(s.height*k)
+    ys,xs=np.where(m>127); cx=(xs.min()+xs.max())/2*k; ox=int(min(max(cx-W/2,0),sw-W)); oy=(shh-H)//2
+    yb=ys.max()*k+20
+    bh=(ys.max()-ys.min())*k
+    if bh<=H-60: oy=int(min(max(yb-H,0),shh-H))                         # bike fits: keep its bottom, leave the room up top
+    else: oy=int(min(max((ys.min()+ys.max())/2*k-H/2,0),shh-H))         # bike too tall for the frame: center it
+    g=grade(s.resize((sw,shh),Image.LANCZOS)).crop((ox,oy,ox+W,oy+H)); g=tan(g)
+    mk=Image.fromarray(m.astype(np.uint8)).resize((sw,shh),Image.LANCZOS).crop((ox,oy,ox+W,oy+H))
+    bgd=np.array(g,np.float32)*0.72; base=Image.fromarray(bgd.astype(np.uint8)).convert('RGBA'); d=ImageDraw.Draw(base,'RGBA')
+    M=np.array(mk)>127
+    # name: Inter Black Italic, stretched edge to edge across the top of the header, behind the bike
+    FONT=FD+'Inter-BlackItalic.otf'; PAD=int(W*0.02)
+    f=ImageFont.truetype(FONT,400); bb=d.textbbox((0,0),big,font=f)
+    f=ImageFont.truetype(FONT,int(400*(W-2*PAD)/(bb[2]-bb[0])))
+    bb=d.textbbox((0,0),big,font=f)
+    if bb[3]-bb[1]>H*0.42: f=ImageFont.truetype(FONT,int(f.size*H*0.42/(bb[3]-bb[1]))); bb=d.textbbox((0,0),big,font=f)
+    ts=((W-(bb[2]-bb[0]))/2-bb[0], PAD-bb[1])
+    # if the bike hides too much of the word up top, move it to the bottom, in front of the bike
+    tm=Image.new('L',(W,H),0); ImageDraw.Draw(tm).text(ts,big,font=f,fill=255); tm=np.array(tm)>127
+    hidden=(tm&M).sum()/max(tm.sum(),1)
+    FRONT_NOW=hidden>MAXTOP
+    if FRONT_NOW: ts=(ts[0], H-PAD-bb[3])
+    txt=Image.new('RGBA',(W,H),(0,0,0,0)); ImageDraw.Draw(txt).text(ts,big,font=f,fill=BLUE+(240,))
+    bike=g.convert('RGBA'); bike.putalpha(mk)
+    if FRONT or FRONT_NOW:
+        base=Image.alpha_composite(base,bike)
+        sh=txt.filter(ImageFilter.GaussianBlur(10)); a=np.array(sh); a[...,:3]=0; a[...,3]=(a[...,3]*0.55).astype(np.uint8)
+        base=Image.alpha_composite(base,Image.fromarray(a)); base=Image.alpha_composite(base,txt)
+    else:
+        base=Image.alpha_composite(base,txt); base=Image.alpha_composite(base,bike)
+    d=ImageDraw.Draw(base)
+    if label: d.text((30,28),label,font=ImageFont.truetype(FD+'Inter-Bold.otf',22),fill=(255,255,255))
+    mm=meta[i]
+    if label: d.text((W-16,H-14),f"Photo: {mm['artist']}, {mm['lic']}",font=ImageFont.truetype(FD+'Inter-Medium.otf',15),fill=(255,255,255,170),anchor='rs')
+    return base.convert('RGB')
+N={"honda-cb750-sohc":("CB750","1975 HONDA CB750"),"harley-street-glide-m8":("GLIDE","2019 HARLEY-DAVIDSON STREET GLIDE"),
+"yamaha-xs650":("XS650","1977 YAMAHA XS650"),"kawasaki-ninja-400":("NINJA","2019 KAWASAKI NINJA 400"),
+"yamaha-mt07-gen1":("MT-07","2016 YAMAHA MT-07"),"kawasaki-klr650-gen2":("KLR","2012 KAWASAKI KLR650")}
+if __name__=='__main__':
+    for i,(b,l) in N.items(): hero(i,b,l).save(f'hero2-{i}.png')
+    ims=[Image.open(f'hero2-{i}.png').resize((600,330)) for i in N]
+    sh=Image.new('RGB',(1230,3*340+10),'white')
+    for n,im in enumerate(ims): sh.paste(im,(10+(n%2)*610,10+(n//2)*340))
+    sh.save('/mnt/user-data/outputs/hero-graded-name.png')
diff --git a/tools/silhouettes/isnet.py b/tools/silhouettes/isnet.py
new file mode 100644
index 0000000..18cd664
--- /dev/null
+++ b/tools/silhouettes/isnet.py
@@ -0,0 +1,19 @@
+"""Cut the bike out with the IS-Net background-removal model (rembg's isnet-general-use.onnx).
+Writes scaled-<id>.jpg, mask-<id>.npy and chk-<id>.jpg like grab2.py."""
+import cv2, numpy as np, onnxruntime as ort, sys, os
+S = ort.InferenceSession('/home/claude/models/isnet-general-use.onnx', providers=['CPUExecutionProvider'])
+def cut(i):
+    im = cv2.imread(f'/tmp/bp/photos/{i}.jpg'); hh, ww = im.shape[:2]
+    s = cv2.resize(im, (1400, int(hh*1400/ww))); H, W = s.shape[:2]
+    x = cv2.resize(cv2.cvtColor(s, cv2.COLOR_BGR2RGB), (1024, 1024)).astype(np.float32)/255
+    x = (x - 0.5) / 1.0
+    p = S.run(None, {S.get_inputs()[0].name: x.transpose(2, 0, 1)[None]})[0][0, 0]
+    p = (p - p.min()) / (p.max() - p.min() + 1e-6)
+    m = cv2.resize(p, (W, H))
+    mk = (m > 0.5).astype(np.uint8)*255
+    n, lab, st, _ = cv2.connectedComponentsWithStats(mk); big = st[1:, 4].max()
+    mk = np.isin(lab, [k for k in range(1, n) if st[k, 4] >= big*0.15]).astype(np.uint8)*255
+    np.save(f'mask-{i}.npy', mk); cv2.imwrite(f'scaled-{i}.jpg', s)
+    v = s.copy(); v[mk == 0] = (v[mk == 0]*0.25 + np.array([0, 0, 180])*0.75).astype(np.uint8)
+    cv2.imwrite(f'chk-{i}.jpg', cv2.resize(v, (700, int(H*700/W))))
+for i in sys.argv[1:]: cut(i); print(i)
diff --git a/tools/silhouettes/make_heroes.py b/tools/silhouettes/make_heroes.py
new file mode 100644
index 0000000..221f44f
--- /dev/null
+++ b/tools/silhouettes/make_heroes.py
@@ -0,0 +1,21 @@
+"""Project header for each library bike: the real photo, color graded, tan filter, model name
+in Revora blue behind the bike. Needs scaled-<id>.jpg and mask-<id>.npy from grab2.py.
+Writes img/hero/<id>.jpg. Run from the folder that holds the scaled photos and masks."""
+import json, sys, pathlib
+sys.path.insert(0, str(pathlib.Path(__file__).parent))
+import hero_lib
+from PIL import ImageDraw
+R = pathlib.Path(__file__).resolve().parents[2]
+hero_lib.W, hero_lib.H = 1600, 900
+import hero as H0; H0.W, H0.H = 1600, 900
+def build(i, name):
+    img = hero_lib.hero(i, name, "")
+    return img
+if __name__ == "__main__":
+    out = R / "img" / "hero"; out.mkdir(exist_ok=True)
+    for t in sorted((R / "data" / "tunes").glob("*.json")):
+        if t.name == "index.json": continue
+        j = json.loads(t.read_text())
+        if not j.get("heroName") or not pathlib.Path(f"mask-{j['id']}.npy").exists(): continue
+        build(j["id"], j["heroName"]).save(out / f"{j['id']}.jpg", quality=86, optimize=True, progressive=True)
+        print(j["id"])
diff --git a/tools/silhouettes/meta.json b/tools/silhouettes/meta.json
new file mode 100644
index 0000000..2f35313
--- /dev/null
+++ b/tools/silhouettes/meta.json
@@ -0,0 +1,304 @@
+{
+ "honda-cb750-sohc": {
+  "file": "Honda CB 750 Four.jpg",
+  "page": "https://commons.wikimedia.org/wiki/File:Honda_CB_750_Four.jpg",
+  "lic": "CC BY 2.0",
+  "licUrl": "https://creativecommons.org/licenses/by/2.0",
+  "artist": "Ronoli"
+ },
+ "honda-rebel-500": {
+  "file": "Honda CMX500 Rebel parked at Hogs for Hospice, Leamington, Ontario, 2025-08-02.jpg",
+  "page": "https://commons.wikimedia.org/wiki/File:Honda_CMX500_Rebel_parked_at_Hogs_for_Hospice,_Leamington,_Ontario,_2025-08-02.jpg",
+  "lic": "CC BY-SA 4.0",
+  "licUrl": "https://creativecommons.org/licenses/by-sa/4.0",
+  "artist": "Chris Woodrich",
+  "photo": "revora-photo-honda-rebel-500-hogs.jpg"
+ },
+ "kawasaki-kz650": {
+  "file": "KZ650-B1 from 2008.jpg",
+  "page": "https://commons.wikimedia.org/wiki/File:KZ650-B1_from_2008.jpg",
+  "lic": "CC BY-SA 4.0",
+  "licUrl": "https://creativecommons.org/licenses/by-sa/4.0",
+  "artist": "Daveymat"
+ },
+ "yamaha-mt07-gen1": {
+  "file": "Yellow Yamaha MT-07 (side-view).jpg",
+  "page": "https://commons.wikimedia.org/wiki/File:Yellow_Yamaha_MT-07_(side-view).jpg",
+  "lic": "CC BY 4.0",
+  "licUrl": "https://creativecommons.org/licenses/by/4.0",
+  "artist": "Trougnouf"
+ },
+ "yamaha-xs650": {
+  "file": "Yamaha XS650 (1977).jpg",
