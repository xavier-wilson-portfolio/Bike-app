diff --git a/tools/silhouettes/style_covers.py b/tools/silhouettes/style_covers.py
new file mode 100644
index 0000000..cc38f2e
--- /dev/null
+++ b/tools/silhouettes/style_covers.py
@@ -0,0 +1,34 @@
+import cv2, json, numpy as np
+R='/home/claude/xavier-wilson-portfolio/bike-app/'
+B={
+"standard":dict(engine=(38,35,70,82),fuel=(45,15,82,42),wheels=(68,48,100,100),suspension=(8,25,38,75),electrical=(62,5,86,45)),
+"cruiser":dict(engine=(45,25,75,75),fuel=(52,8,85,40),wheels=(68,38,100,100),suspension=(5,25,38,90),electrical=(72,3,98,52)),
+"sport":dict(engine=(35,40,70,90),fuel=(38,15,70,45),wheels=(65,45,100,100),suspension=(2,30,40,95),electrical=(70,0,95,45)),
+"touring":dict(engine=(55,45,90,85),fuel=(40,20,80,52),wheels=(78,50,100,100),suspension=(5,40,45,100),electrical=(68,0,95,50)),
+"dualsport":dict(engine=(30,35,65,75),fuel=(35,15,75,45),wheels=(65,40,100,100),suspension=(2,40,40,100),electrical=(55,0,80,40)),
+"adventure":dict(engine=(25,45,65,90),fuel=(35,15,75,50),wheels=(60,45,100,100),suspension=(0,40,40,100),electrical=(60,0,90,45)),
+"cafe":dict(engine=(35,30,70,90),fuel=(35,12,68,42),wheels=(68,30,100,100),suspension=(2,25,35,95),electrical=(65,0,85,40)),
+"scooter":dict(engine=(10,50,50,100),fuel=(5,20,60,60),wheels=(78,50,100,100),suspension=(0,40,40,100),electrical=(60,0,100,45)),
+}
+NAMES={"engine":"Engine","fuel":"Fuel tank","wheels":"Front wheel","suspension":"Rear suspension","electrical":"Headlight"}
+cred=json.load(open(R+'img/sil/credits.json'))
+def vec(black):
+    cs,_=cv2.findContours(black,cv2.RETR_CCOMP,cv2.CHAIN_APPROX_NONE); H,W=black.shape; d=[]
+    for c in cs:
+        if cv2.contourArea(c)<25: continue
+        a=cv2.approxPolyDP(c,1.2,True).reshape(-1,2)
+        if len(a)>=3: d.append('M'+' L'.join(f'{x} {y}' for x,y in a)+'Z')
+    return W,H,''.join(d)
+for s,areas in B.items():
+    im=cv2.imread(f'{s}.png',0); black=(im<128).astype(np.uint8)*255; H,W=black.shape
+    src=cred.get(f'bike-{s}.svg',{})
+    for a,b in areas.items():
+        x0,y0,x1,y1=[int(v*z/100) for v,z in zip(b,(W,H,W,H))]
+        c=black[y0:y1,x0:x1]
+        ys,xs=np.where(c>0); c=c[ys.min():ys.max()+1, xs.min():xs.max()+1]
+        c=cv2.copyMakeBorder(c,4,4,4,4,cv2.BORDER_CONSTANT,0)
+        w,h,d=vec(c)
+        open(f'{a}-{s}.svg','w').write(f'<svg role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {w} {h}" preserveAspectRatio="xMidYMid meet"><!-- {NAMES[a]} cover for the {s} style, cut from the {s} silhouette --><path fill="#000" fill-rule="evenodd" d="{d}"/></svg>')
+        cv2.imwrite(f'{a}-{s}.png',255-c)
+        cred[f'{a}-{s}.svg']=dict(src, what=f"{NAMES[a]} ({s} style)")
+json.dump(cred,open('credits-new.json','w'),indent=1,ensure_ascii=False)
diff --git a/tools/silhouettes/trace.py b/tools/silhouettes/trace.py
new file mode 100644
index 0000000..19c3bca
--- /dev/null
+++ b/tools/silhouettes/trace.py
@@ -0,0 +1,57 @@
+import cv2, json, numpy as np, sys
+meta=json.load(open('meta.json'))
+FLIP={}  # all bikes face left (front on the left) like the existing set? decided per bike below
+def trace(i, thr=0.74, out='out'):
+    s=cv2.imread(f'scaled-{i}.jpg'); m=np.load(f'mask-{i}.npy')
+    # crop to the bike
+    Hs,Ws=m.shape
+    ys,xs=np.where(m>0); x0,x1,y0,y1=xs.min(),xs.max(),ys.min(),ys.max(); pad=6
+    s=s[y0:y1+1,x0:x1+1]; m=m[y0:y1+1,x0:x1+1]
+    s=cv2.copyMakeBorder(s,pad,pad,pad,pad,cv2.BORDER_REPLICATE); m=cv2.copyMakeBorder(m,pad,pad,pad,pad,cv2.BORDER_CONSTANT,0)
+    # upscale 2x for smoother outlines
+    s=cv2.resize(s,None,fx=2,fy=2,interpolation=cv2.INTER_CUBIC); m=cv2.resize(m,None,fx=2,fy=2,interpolation=cv2.INTER_LINEAR)
+    m=(cv2.GaussianBlur(m,(0,0),2.0)>127).astype(np.uint8)*255
+    # highlights: only the clear, bigger bright areas (chrome, paint shine) become white cut-outs
+    L=cv2.cvtColor(s,cv2.COLOR_BGR2LAB)[:,:,0]
+    Lw=cv2.GaussianBlur(L,(0,0),1.0).astype(np.float32); m2=m.copy()
+    L=cv2.bilateralFilter(L,9,40,9); L=cv2.createCLAHE(2.0,(8,8)).apply(L).astype(np.float32)
+    L=cv2.GaussianBlur(L,(0,0),1.2)
+    t=np.quantile(L[m>0],thr)
+    hi=((L>t)&(m>0)).astype(np.uint8)*255
+    hi=cv2.morphologyEx(hi,cv2.MORPH_OPEN,np.ones((3,3),np.uint8))
+    rim=cv2.erode(m,np.ones((9,9),np.uint8)); hi=cv2.bitwise_and(hi,rim)
+    n,lab,st,_=cv2.connectedComponentsWithStats(hi)
+    for k in range(1,n):
+        if st[k,4]<120: hi[lab==k]=0
+    black=cv2.bitwise_and(m,cv2.bitwise_not(hi))
+    # smooth every edge, then drop specks and pinholes
+    black=(cv2.GaussianBlur(black,(0,0),1.1)>127).astype(np.uint8)*255
+    n,lab,st,_=cv2.connectedComponentsWithStats(black)
+    for k in range(1,n):
+        if st[k,4]<120: black[lab==k]=0
+    inv=cv2.bitwise_and(cv2.bitwise_not(black),m)
+    n,lab,st,_=cv2.connectedComponentsWithStats(inv)
+    for k in range(1,n):
+        if st[k,4]<60: black[lab==k]=255
+    from wfit import WH
+    n,lab,st,_=cv2.connectedComponentsWithStats(black)
+    if n>1:
+        big=1+np.argmax(st[1:,4])
+        for k in range(1,n):
+            if k!=big and st[k,4]<st[big,4]*0.003: black[lab==k]=0
+    black=(cv2.GaussianBlur(black,(0,0),1.2)>127).astype(np.uint8)*255
+    if meta[i].get('flip'): black=cv2.flip(black,1)
+    cv2.imwrite(f'{out}-{i}.png',255-black)
+    # vector: contours with holes, even-odd fill
+    cs,hier=cv2.findContours(black,cv2.RETR_CCOMP,cv2.CHAIN_APPROX_NONE)
+    H,W=black.shape; d=[]
+    for c in cs:
+        if cv2.contourArea(c)<60: continue
+        a=cv2.approxPolyDP(c,1.0,True).reshape(-1,2)
+        if len(a)<3: continue
+        d.append('M'+' L'.join(f'{x} {y}' for x,y in a)+'Z')
+    m2=meta[i]
+    svg=f'<svg role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" preserveAspectRatio="xMidYMid meet"><!-- Silhouette traced from \'{m2["file"]}\' by {m2["artist"]} on Wikimedia Commons, {m2["lic"]} --><path fill="#000" fill-rule="evenodd" d="{"".join(d)}"/></svg>'
+    open(f'{out}-{i}.svg','w').write(svg); return len(svg)
+if __name__=="__main__":
+    for i in (sys.argv[1:] or list(meta)): print(i, trace(i))
diff --git a/tools/silhouettes/wfit.py b/tools/silhouettes/wfit.py
new file mode 100644
index 0000000..74faf62
--- /dev/null
+++ b/tools/silhouettes/wfit.py
@@ -0,0 +1,31 @@
+import cv2,numpy as np,json,sys
+# wheel circles on the scaled photo: (cx% of W, cy% of H, r% of W)
+WH={
+"honda-rebel-500":[(26,70,12,12),(80,72.5,16.5,17)],
