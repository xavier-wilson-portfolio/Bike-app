+   "Shaft drive",
+   "Final drive oil"
+  ]
+ ],
+ "remove": [
+  "G-005"
+ ],
+ "patch": {},
+ "add": [
+  {
+   "id": "X-GW-BELT",
+   "phase": "H",
+   "after": "H-003",
+   "title": "Replace the timing belts",
+   "instructions": "If you can't prove the timing belts were changed in the last 10 years, replace them and the tensioners. Look at the water pump while the front cover is off.",
+   "reason": "A snapped timing belt on these engines can bend valves.",
+   "src": "The GS Resources Gold Wing thread",
+   "safety": "Normal",
+   "skill": "Advanced",
+   "estHours": 3.0,
+   "tools": ""
+  }
+ ],
+ "lessons": {
+  "F": [
+   "The stator sits at the back of the engine and the engine has to come out to change it. Test charging before you decide."
+  ]
+ },
+ "recalls": [],
+ "recallNote": "Any recalls on bikes this old were closed long ago.",
+ "known": [
+  {
+   "title": "Timing belts",
+   "what": "Replace them every 10 years or 100,000 miles, even if they look fine.",
+   "src": "https://www.thegsresources.com/_forum/forum/other-bikes/other-questions/86883-goldwing-what-are-the-usual-suspects-to-watch-out-for?p=1521205"
+  }
