+   "phase": "H",
+   "after": "H-003",
+   "title": "Inspect the cams and rockers",
+   "instructions": "With the valve covers off, look at the cam lobes and rocker faces for pitting and wear. Check the oil feed to the heads.",
+   "reason": "Premature cam and rocker wear is the best-known problem on first-generation Honda V4s.",
+   "src": "The Honda V4 Cam Story",
+   "safety": "Normal",
+   "skill": "Advanced",
+   "estHours": 3.0,
+   "tools": ""
+  }
+ ],
+ "lessons": {
