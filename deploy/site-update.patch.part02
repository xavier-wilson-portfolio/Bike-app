+{
+ "id": "honda-gold-wing-gl1100-1980",
+ "make": "Honda",
+ "model": "Gold Wing GL1100",
+ "name": "Honda Gold Wing GL1100",
+ "years": [
+  1980,
+  1983
+ ],
+ "match": [
+  "gl1100",
+  "gold wing 1100",
+  "goldwing 1100",
+  "gl1100i",
+  "interstate 1100",
+  "aspencade 1100"
+ ],
+ "style": "touring",
+ "drive": "shaft",
+ "engine": "1085 cc liquid-cooled flat four, timing belts, shaft drive",
+ "intro": "A flat-four Gold Wing. Timing belts and the stator, which sits behind the engine, are the big jobs.",
+ "focus": [
+  [
+   "Flat four",
+   "Liquid-cooled"
+  ],
+  [
+   "Timing belts",
+   "Change by age"
+  ],
