+   "title": "Check for open recalls",
+   "instructions": "Run your VIN at nhtsa.gov/recalls. 2005-2013 GSX-R1000s are in recall 13V449 (front brake master cylinder). 2009-2014 bikes are in recall 14V629 (chain adjuster).",
+   "reason": "Both are safety recalls and the fixes are free."
+  }
+ },
+ "add": [],
+ "lessons": {
+  "K": [
+   "Old brake fluid is what makes the master cylinder piston corrode. Change it on schedule."
+  ]
+ },
+ "recalls": [
+  {
+   "id": "13V449",
+   "years": "2004-2013 (GSX-R750); 2005-2013 (GSX-R1000)",
+   "what": "With old brake fluid, the front brake master cylinder piston can corrode and give a soft brake.",
+   "fix": "Free dealer repair.",
+   "src": "https://vehiclesafetyrecalls.com/recall/13V449000"
+  },
+  {
+   "id": "14V629",
+   "years": "2011-2014 (GSX-R750); 2009-2014 (GSX-R1000)",
+   "what": "After a missed upshift, the chain strain can move the rear axle and the chain may come off.",
+   "fix": "Dealer fits an improved left chain adjuster free.",
+   "src": "https://vehiclesafetyrecalls.com/recall/14V629000"
+  }
+ ],
+ "known": [],
+ "forums": [],
+ "silhouette": "suzuki-gsx-r1000-2001",
+ "areas": [],
